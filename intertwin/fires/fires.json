{
  "name": "Fires",
  "author": "CMCC",
  "abstract": "This workflow evaluate the fire metrics given the datasets of several scenarios and models using PyOphidia",
  "exec_mode": "sync",
  "tasks": [
    {
      "type": "ophidia",
      "name": "Init frequency",
      "operator": "oph_set",
      "arguments": [
        "key=frequency",
        "value=Eday|day|day|day|day|fx"
      ],
      "dependencies": [],
      "extra": {}
    },
    {
      "type": "ophidia",
      "name": "Init measure",
      "operator": "oph_set",
      "arguments": [
        "key=measure",
        "value=lai|lst_day|rel_hum|t2m_min|pr|lsm"
      ],
      "dependencies": [],
      "extra": {}
    },
    {
      "type": "ophidia",
      "name": "Init institutes",
      "operator": "oph_set",
      "arguments": [
        "key=institute",
        "value=CMCC|NCC"
      ],
      "dependencies": [],
      "extra": {}
    },
    {
      "type": "ophidia",
      "name": "Init reduction operations",
      "operator": "oph_set",
      "arguments": [
        "key=reduction_op",
        "value=median|median|median|median|sum|none"
      ],
      "dependencies": [],
      "extra": {}
    },
    {
      "type": "ophidia",
      "name": "Clear output folder",
      "operator": "oph_generic",
      "arguments": [
        "command=/home/jovyan/work/fires/clear.sh",
        "input=/home/jovyan/work/fires/output/",
        "output=null"
      ],
      "dependencies": [
        {
          "task": "Init frequency"
        },
        {
          "task": "Init measure"
        },
        {
          "task": "Init institutes"
        },
        {
          "task": "Init reduction operations"
        }
      ],
      "extra": {},
      "on_error": "skip"
    },
    {
      "type": "ophidia",
      "name": "Create a work container",
      "operator": "oph_createcontainer",
      "arguments": [
        "container=fires",
        "dim=time|plev|lat|lon",
        "hierarchy=oph_time|oph_base|oph_base|oph_base"
      ],
      "dependencies": [
        {
          "task": "Clear output folder"
        }
      ],
      "extra": {},
      "on_error": "skip"
    },
    {
      "type": "ophidia",
      "name": "Import mask",
      "operator": "oph_importnc2",
      "arguments": [
        "imp_dim=time",
        "measure=basis_regions",
        "src_path=/home/jovyan/work/fires/mask.nc",
        "container=fires",
        "nfrag=1"
      ],
      "dependencies": [
        {
          "task": "Create a work container"
        }
      ],
      "extra": {}
    },
    {
      "type": "ophidia",
      "name": "Iterate on scenarios",
      "operator": "oph_for",
      "arguments": [
        "parallel=yes",
        "key=scenario",
        "values=ssp126"
      ],
      "dependencies": [
        {
          "task": "Create a work container"
        }
      ],
      "extra": {}
    },
    {
      "type": "ophidia",
      "name": "Iterate on models",
      "operator": "oph_for",
      "arguments": [
        "parallel=yes",
        "key=model",
        "values=CMCC-ESM2|NorESM2-MM"
      ],
      "dependencies": [
        {
          "task": "Iterate on scenarios"
        }
      ],
      "extra": {}
    },
    {
      "type": "ophidia",
      "name": "Iterate on variables",
      "operator": "oph_for",
      "arguments": [
        "parallel=yes",
        "key=variable",
        "values=lai|tasmax|hur|tasmin|pr|sftlf"
      ],
      "dependencies": [
        {
          "task": "Iterate on models"
        }
      ],
      "extra": {}
    },
    {
      "type": "ophidia",
      "name": "Check for reduction operation",
      "operator": "oph_if",
      "arguments": [
        "condition=&{variable}-6"
      ],
      "dependencies": [
        {
          "task": "Iterate on variables"
        }
      ],
      "extra": {}
    },
    {
      "type": "ophidia",
      "name": "Check for selection operation",
      "operator": "oph_if",
      "arguments": [
        "condition=&{variable}-3"
      ],
      "dependencies": [
        {
          "task": "Check for reduction operation"
        }
      ],
      "extra": {}
    },
    {
      "type": "ophidia",
      "name": "Import variable",
      "operator": "oph_importncs",
      "arguments": [
        "imp_dim=time",
        "measure=@variable",
        "src_path=/home/jovyan/data/CMIP6/ScenarioMIP/@{institute_&{model}}/@{model}/@{scenario}/r1i1p1f1/@{frequency_&{variable}}/@{variable}/gn/*/@{variable}_@{frequency_&{variable}}_@{model}_@{scenario}_r1i1p1f1_gn*.nc",
        "container=fires",
        "nfrag=1",
        "subset_dims=time",
        "subset_filter=2030-01-01_2036-01-01",
        "subset_type=coord"
      ],
      "dependencies": [
        {
          "task": "Check for selection operation"
        }
      ],
      "extra": {}
    },
    {
      "type": "ophidia",
      "name": "Check for rescaling operation",
      "operator": "oph_if",
      "arguments": [
        "condition=step(&{variable}-5)*step(5-&{variable})",
        "forward=yes"
      ],
      "dependencies": [
        {
          "argument": "cube",
          "task": "Import variable"
        }
      ],
      "extra": {}
    },
    {
      "type": "ophidia",
      "name": "Rescale pr",
      "operator": "oph_apply",
      "arguments": [
        "query=oph_matheval(measure,'x*3600*24')",
        "measure_type=auto"
      ],
      "dependencies": [
        {
          "argument": "cube",
          "task": "Check for rescaling operation"
        }
      ],
      "extra": {}
    },
    {
      "type": "ophidia",
      "name": "End rescaling selection",
      "operator": "oph_endif",
      "arguments": [],
      "dependencies": [
        {
          "argument": "cube",
          "task": "Rescale pr"
        }
      ],
      "extra": {}
    },
    {
      "type": "ophidia",
      "name": "Else selection",
      "operator": "oph_else",
      "arguments": [],
      "dependencies": [
        {
          "task": "Check for selection operation"
        }
      ],
      "extra": {}
    },
    {
      "type": "ophidia",
      "name": "Import hur",
      "operator": "oph_importncs",
      "arguments": [
        "imp_dim=time",
        "measure=@variable",
        "src_path=/home/jovyan/data/CMIP6/ScenarioMIP/@{institute_&{model}}/@{model}/@{scenario}/r1i1p1f1/@{frequency_&{variable}}/@{variable}/gn/*/@{variable}_@{frequency_&{variable}}_@{model}_@{scenario}_r1i1p1f1_gn*.nc",
        "container=fires",
        "nfrag=1",
        "subset_dims=plev|time",
        "subset_filter=100000|2030-01-01_2036-01-01",
        "subset_type=coord|coord"
      ],
      "dependencies": [
        {
          "task": "Else selection"
        }
      ],
      "extra": {}
    },
    {
      "type": "ophidia",
      "name": "End check selection",
      "operator": "oph_endif",
      "arguments": [],
      "dependencies": [
        {
          "argument": "cube",
          "task": "End rescaling selection"
        },
        {
          "argument": "cube",
          "task": "Import hur"
        }
      ],
      "extra": {}
    },
    {
      "type": "ophidia",
      "name": "Reduction on octets",
      "operator": "oph_reduce2",
      "arguments": [
        "operation=@{reduction_op_&{variable}}",
        "concept_level=o"
      ],
      "dependencies": [
        {
          "argument": "cube",
          "task": "End check selection"
        }
      ],
      "extra": {}
    },
    {
      "type": "ophidia",
      "name": "Else reduction",
      "operator": "oph_else",
      "arguments": [],
      "dependencies": [
        {
          "task": "Check for reduction operation"
        }
      ],
      "extra": {}
    },
    {
      "type": "ophidia",
      "name": "Import sftlf",
      "operator": "oph_importncs",
      "arguments": [
        "measure=@variable",
        "src_path=/home/jovyan/data/CMIP6/ScenarioMIP/@{institute_&{model}}/@{model}/@{scenario}/r1i1p1f1/@{frequency_&{variable}}/@{variable}/gn/*/@{variable}_@{frequency_&{variable}}_@{model}_@{scenario}_r1i1p1f1_gn.nc",
        "container=fires",
        "nfrag=1"
      ],
      "dependencies": [
        {
          "task": "Else reduction"
        }
      ],
      "extra": {}
    },
    {
      "type": "ophidia",
      "name": "Rescale sftlf",
      "operator": "oph_apply",
      "arguments": [
        "query=oph_matheval(measure,'x/100')",
        "measure_type=auto"
      ],
      "dependencies": [
        {
          "argument": "cube",
          "task": "Import sftlf"
        }
      ],
      "extra": {}
    },
    {
      "type": "ophidia",
      "name": "End check reduction",
      "operator": "oph_endif",
      "arguments": [],
      "dependencies": [
        {
          "argument": "cube",
          "task": "Reduction on octets"
        },
        {
          "argument": "cube",
          "task": "Rescale sftlf"
        }
      ],
      "extra": {}
    },
    {
      "type": "ophidia",
      "name": "Rename measure",
      "operator": "oph_apply",
      "arguments": [
        "measure=@{measure_&{variable}}"
      ],
      "dependencies": [
        {
          "argument": "cube",
          "task": "End check reduction"
        }
      ],
      "extra": {}
    },
    {
      "type": "ophidia",
      "name": "Export variable",
      "operator": "oph_exportnc2",
      "arguments": [
        "output=/home/jovyan/work/fires/output/@{variable}_@{frequency_&{variable}}_@{model}_@{scenario}_r1i1p1f1_gn_2030-01-01_2036-01-01.nc"
      ],
      "dependencies": [
        {
          "argument": "cube",
          "task": "Rename measure"
        }
      ],
      "extra": {}
    },
    {
      "type": "ophidia",
      "name": "Regrid variable",
      "operator": "oph_generic",
      "arguments": [
        "command=/home/jovyan/work/fires/regrid.sh",
        "output=/home/jovyan/work/fires/output/regridded_@{model}_@{scenario}.nc",
        "args=-90:90 0:360 interp_like @{measure_&{variable}}"
      ],
      "dependencies": [
        {
          "argument": "input",
          "task": "Export variable"
        }
      ],
      "extra": {}
    },
    {
      "type": "ophidia",
      "name": "End iteration on variables",
      "operator": "oph_endfor",
      "arguments": [],
      "dependencies": [
        {
          "task": "Regrid variable"
        }
      ],
      "extra": {}
    },
    {
      "type": "ophidia",
      "name": "Infer data",
      "operator": "oph_generic",
      "arguments": [
        "command=/home/jovyan/work/fires/inference.sh",
        "input=/home/jovyan/work/fires/output/regridded_@{model}_@{scenario}.nc",
        "output=/home/jovyan/work/fires/output/fires_@{model}_@{scenario}.nc",
        "args=global_burned_areas"
      ],
      "dependencies": [
        {
          "task": "End iteration on variables"
        }
      ],
      "extra": {}
    },
    {
      "type": "ophidia",
      "name": "Import model",
      "operator": "oph_importnc2",
      "arguments": [
        "imp_dim=time",
        "measure=global_burned_areas",
        "container=fires",
        "nfrag=1",
        "imp_concept_level=o"
      ],
      "dependencies": [
        {
          "argument": "input",
          "task": "Infer data"
        }
      ],
      "extra": {}
    },
    {
      "type": "ophidia",
      "name": "Reduction on years",
      "operator": "oph_reduce2",
      "arguments": [
        "operation=avg",
        "concept_level=y"
      ],
      "dependencies": [
        {
          "argument": "cube",
          "task": "Import model"
        }
      ],
      "extra": {}
    },
    {
      "type": "ophidia",
      "name": "Apply the mask",
      "operator": "oph_intercube",
      "arguments": [
        "operation=mul",
        "extension_type=append"
      ],
      "dependencies": [
        {
          "argument": "cube",
          "task": "Reduction on years"
        },
        {
          "argument": "cube2",
          "task": "Import mask"
        }
      ],
      "extra": {}
    },
    {
      "type": "ophidia",
      "name": "Export model",
      "operator": "oph_exportnc2",
      "arguments": [
        "output=/home/jovyan/work/fires/output/inferenced_@{model}_@{scenario}.nc"
      ],
      "dependencies": [
        {
          "argument": "cube",
          "task": "Apply the mask"
        }
      ],
      "extra": {}
    },
    {
      "type": "ophidia",
      "name": "End iteration on models",
      "operator": "oph_endfor",
      "arguments": [],
      "dependencies": [
        {
          "argument": "cube",
          "task": "Apply the mask"
        },
        {
          "task": "Export model"
        }
      ],
      "extra": {}
    },
    {
      "type": "ophidia",
      "name": "Merge models",
      "operator": "oph_mergecubes2",
      "arguments": [
        "dim=ensemble"
      ],
      "dependencies": [
        {
          "argument": "cubes",
          "task": "End iteration on models"
        }
      ],
      "extra": {}
    },
    {
      "type": "ophidia",
      "name": "Iterate on ensemble operations",
      "operator": "oph_for",
      "arguments": [
        "parallel=yes",
        "key=operation",
        "values=avg|min|max|var|std"
      ],
      "dependencies": [
        {
          "argument": "cube",
          "task": "Merge models"
        }
      ],
      "extra": {}
    },
    {
      "type": "ophidia",
      "name": "Ensemble operation",
      "operator": "oph_reduce2",
      "arguments": [
        "operation=@{operation}",
        "dim=ensemble"
      ],
      "dependencies": [
        {
          "argument": "cube",
          "task": "Iterate on ensemble operations"
        }
      ],
      "extra": {}
    },
    {
      "type": "ophidia",
      "name": "Export scenario",
      "operator": "oph_exportnc2",
      "arguments": [
        "output=/home/jovyan/work/fires/output/@{operation}_@{scenario}.nc"
      ],
      "dependencies": [
        {
          "argument": "cube",
          "task": "Ensemble operation"
        }
      ],
      "extra": {}
    },
    {
      "type": "ophidia",
      "name": "End iteration on ensemble operations",
      "operator": "oph_endfor",
      "arguments": [],
      "dependencies": [
        {
          "task": "Export scenario"
        }
      ],
      "extra": {}
    },
    {
      "type": "ophidia",
      "name": "End iteration on scenarios",
      "operator": "oph_endfor",
      "arguments": [],
      "dependencies": [
        {
          "task": "End iteration on ensemble operations"
        }
      ],
      "extra": {}
    },
    {
      "type": "ophidia",
      "name": "Destroy the work container",
      "operator": "oph_deletecontainer",
      "arguments": [
        "container=fires",
        "force=yes"
      ],
      "dependencies": [
        {
          "task": "End iteration on scenarios"
        }
      ],
      "extra": {},
      "on_error": "skip"
    }
  ],
  "host_partition": "partition",
  "on_exit": "oph_delete",
  "nthreads": "1",
  "ncores": "1"
}
